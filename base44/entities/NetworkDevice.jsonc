{
  "name": "NetworkDevice",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "type": {
      "type": "string",
      "title": "Type",
      "enum": [
        "router",
        "switch",
        "firewall",
        "access_point",
        "server_nic",
        "management_controller",
        "other"
      ],
      "default": "switch"
    },
    "manufacturer": {
      "type": "string",
      "title": "Manufacturer"
    },
    "model": {
      "type": "string",
      "title": "Model"
    },
    "management_address": {
      "type": "string",
      "title": "Management address"
    },
    "port_count": {
      "type": "number",
      "title": "Port count"
    },
    "location": {
      "type": "string",
      "title": "Location"
    },
    "lifecycle_state": {
      "type": "string",
      "title": "Lifecycle state",
      "enum": [
        "planned",
        "onboarding",
        "active",
        "experimental",
        "maintenance",
        "degraded",
        "retiring",
        "retired"
      ],
      "default": "active"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "tags": {
      "type": "array",
      "title": "Tags",
      "items": {
        "type": "string"
      }
    },
    "canonical_id": {
      "type": "string",
      "title": "Canonical ID"
    },
    "source_kind": {
      "type": "string",
      "title": "Source kind",
      "enum": [
        "canonical",
        "manual",
        "observed",
        "inferred",
        "planned",
        "sample"
      ],
      "default": "manual"
    },
    "source_repository": {
      "type": "string",
      "title": "Source repository"
    },
    "source_version": {
      "type": "string",
      "title": "Source schema version"
    },
    "source_commit": {
      "type": "string",
      "title": "Source commit (value change)"
    },
    "imported_at": {
      "type": "string",
      "format": "date-time",
      "title": "Imported at (value change)"
    },
    "last_seen_source_commit": {
      "type": "string",
      "title": "Last seen in canonical snapshot (commit)"
    },
    "last_seen_import_at": {
      "type": "string",
      "format": "date-time",
      "title": "Last seen in canonical snapshot (import time)"
    }
  },
  "required": [
    "name",
    "type"
  ]
}