{
  "name": "ExecutionEnvironment",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "type": {
      "type": "string",
      "title": "Type",
      "enum": [
        "physical_host",
        "vm",
        "lxc",
        "docker",
        "podman",
        "kubernetes",
        "external_service"
      ],
      "default": "vm"
    },
    "current_host": {
      "type": "string",
      "title": "Current host node (id)"
    },
    "cpu_allocation": {
      "type": "number",
      "title": "CPU allocation (cores)"
    },
    "ram_allocation_gb": {
      "type": "number",
      "title": "RAM allocation (GB)"
    },
    "storage_allocation_gb": {
      "type": "number",
      "title": "Storage allocation (GB)"
    },
    "lifecycle": {
      "type": "string",
      "title": "Lifecycle",
      "enum": [
        "planned",
        "onboarding",
        "active",
        "experimental",
        "maintenance",
        "degraded",
        "retiring",
        "retired"
      ],
      "default": "active"
    },
    "reconstructable": {
      "type": "boolean",
      "title": "Reconstructable",
      "default": true
    },
    "persistent_state": {
      "type": "boolean",
      "title": "Persistent state",
      "default": false
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "canonical_id": {
      "type": "string",
      "title": "Canonical ID (e.g. execution-provider:tools1)"
    },
    "source_kind": {
      "type": "string",
      "title": "Source kind",
      "enum": [
        "canonical",
        "manual",
        "observed",
        "inferred",
        "planned",
        "sample"
      ],
      "default": "manual"
    },
    "source_repository": {
      "type": "string",
      "title": "Source repository"
    },
    "source_version": {
      "type": "string",
      "title": "Source schema version"
    },
    "source_commit": {
      "type": "string",
      "title": "Source commit (value change)"
    },
    "imported_at": {
      "type": "string",
      "format": "date-time",
      "title": "Imported at (value change)"
    },
    "last_seen_source_commit": {
      "type": "string",
      "title": "Last seen in canonical snapshot (commit)"
    },
    "last_seen_import_at": {
      "type": "string",
      "format": "date-time",
      "title": "Last seen in canonical snapshot (import time)"
    },
    "field_provenance": {
      "type": "string",
      "title": "Field-level provenance overlay (JSON)"
    }
  },
  "required": [
    "name",
    "type"
  ]
}