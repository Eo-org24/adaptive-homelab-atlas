{
  "name": "Workload",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Canonical name"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "category": {
      "type": "string",
      "title": "Category",
      "enum": [
        "infrastructure",
        "networking",
        "storage",
        "observability",
        "ai_inference",
        "ai_tooling",
        "automation",
        "documentation",
        "development",
        "experimental",
        "user_application"
      ],
      "default": "user_application"
    },
    "current_environment": {
      "type": "string",
      "title": "Current execution environment (id)"
    },
    "current_host": {
      "type": "string",
      "title": "Current host node (id) \u2014 derived from environment"
    },
    "preferred_node": {
      "type": "string",
      "title": "Preferred node (id)"
    },
    "eligible_alternative_nodes": {
      "type": "array",
      "title": "Eligible alternative nodes",
      "items": {
        "type": "string"
      }
    },
    "cpu_requirement": {
      "type": "number",
      "title": "CPU requirement (cores)"
    },
    "ram_requirement_gb": {
      "type": "number",
      "title": "RAM requirement (GB)"
    },
    "gpu_requirement": {
      "type": "string",
      "title": "GPU requirement (free text \u2014 not verified)"
    },
    "gpu_vram_requirement_gb": {
      "type": "number",
      "title": "GPU VRAM requirement (GB)"
    },
    "required_gpu_class": {
      "type": "string",
      "title": "Required GPU class / capability"
    },
    "storage_requirement_gb": {
      "type": "number",
      "title": "Storage requirement (GB)"
    },
    "network_requirement": {
      "type": "string",
      "title": "Network requirement (free text \u2014 not verified)"
    },
    "minimum_network_mbps": {
      "type": "number",
      "title": "Minimum network (Mbps)"
    },
    "required_capabilities": {
      "type": "array",
      "title": "Required capabilities",
      "items": {
        "type": "string"
      }
    },
    "availability_requirement": {
      "type": "string",
      "title": "Availability requirement",
      "enum": [
        "always_on",
        "business_hours",
        "on_demand",
        "best_effort"
      ],
      "default": "best_effort"
    },
    "state_classification": {
      "type": "string",
      "title": "State classification (provenance)",
      "enum": [
        "documented",
        "observed",
        "imported",
        "inferred",
        "planned",
        "sample"
      ],
      "default": "documented"
    },
    "criticality": {
      "type": "string",
      "title": "Criticality",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "lifecycle": {
      "type": "string",
      "title": "Lifecycle",
      "enum": [
        "planned",
        "onboarding",
        "active",
        "experimental",
        "maintenance",
        "degraded",
        "retiring",
        "retired"
      ],
      "default": "active"
    },
    "reconstructable": {
      "type": "boolean",
      "title": "Reconstructable",
      "default": true
    },
    "backup_requirement": {
      "type": "string",
      "title": "Backup requirement"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "tags": {
      "type": "array",
      "title": "Tags",
      "items": {
        "type": "string"
      }
    },
    "canonical_id": {
      "type": "string",
      "title": "Canonical ID (e.g. workload:plex)"
    },
    "source_kind": {
      "type": "string",
      "title": "Source kind",
      "enum": [
        "canonical",
        "manual",
        "observed",
        "inferred",
        "planned",
        "sample"
      ],
      "default": "manual"
    },
    "source_repository": {
      "type": "string",
      "title": "Source repository"
    },
    "source_version": {
      "type": "string",
      "title": "Source schema version"
    },
    "source_commit": {
      "type": "string",
      "title": "Source commit (value change)"
    },
    "imported_at": {
      "type": "string",
      "format": "date-time",
      "title": "Imported at (value change)"
    },
    "last_seen_source_commit": {
      "type": "string",
      "title": "Last seen in canonical snapshot (commit)"
    },
    "last_seen_import_at": {
      "type": "string",
      "format": "date-time",
      "title": "Last seen in canonical snapshot (import time)"
    },
    "external_id": {
      "type": "string",
      "title": "External canonical ID (legacy)"
    },
    "import_source": {
      "type": "string",
      "title": "Import source (legacy)"
    },
    "import_timestamp": {
      "type": "string",
      "format": "date-time",
      "title": "Import timestamp (legacy)"
    },
    "source_note": {
      "type": "string",
      "title": "Provenance source note"
    },
    "confidence": {
      "type": "number",
      "title": "Confidence (0-1)"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Observed at"
    },
    "field_provenance": {
      "type": "string",
      "title": "Field-level provenance overlay (JSON)"
    }
  },
  "required": [
    "name",
    "category"
  ]
}