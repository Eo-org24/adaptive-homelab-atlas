{
  "name": "StoragePool",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Pool name"
    },
    "node": {
      "type": "string",
      "title": "Node (id)"
    },
    "device_ids": {
      "type": "array",
      "title": "Participating devices",
      "items": {
        "type": "string"
      }
    },
    "raid_level": {
      "type": "string",
      "title": "RAID level",
      "enum": [
        "single",
        "raid0",
        "raid1",
        "raid5",
        "raid6",
        "raid10",
        "zfs_mirror",
        "zfs_raidz1",
        "zfs_raidz2",
        "other"
      ],
      "default": "single"
    },
    "usable_capacity_gb": {
      "type": "number",
      "title": "Usable capacity (GB)"
    },
    "state": {
      "type": "string",
      "title": "State",
      "enum": [
        "active",
        "degraded",
        "maintenance",
        "planned",
        "retired"
      ],
      "default": "active"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "canonical_id": {
      "type": "string",
      "title": "Canonical ID"
    },
    "source_kind": {
      "type": "string",
      "title": "Source kind",
      "enum": [
        "canonical",
        "manual",
        "observed",
        "inferred",
        "planned",
        "sample"
      ],
      "default": "manual"
    },
    "source_repository": {
      "type": "string",
      "title": "Source repository"
    },
    "source_version": {
      "type": "string",
      "title": "Source schema version"
    },
    "source_commit": {
      "type": "string",
      "title": "Source commit"
    },
    "imported_at": {
      "type": "string",
      "format": "date-time",
      "title": "Imported at"
    }
  },
  "required": [
    "name"
  ]
}