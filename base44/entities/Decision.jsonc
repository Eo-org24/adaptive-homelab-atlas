{
  "name": "Decision",
  "type": "object",
  "properties": {
    "decision_id": {
      "type": "string",
      "title": "Decision ID"
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "context": {
      "type": "string",
      "title": "Context"
    },
    "decision": {
      "type": "string",
      "title": "Decision"
    },
    "rationale": {
      "type": "string",
      "title": "Rationale"
    },
    "alternatives": {
      "type": "string",
      "title": "Alternatives considered"
    },
    "consequences": {
      "type": "string",
      "title": "Consequences"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "proposed",
        "accepted",
        "rejected",
        "deprecated",
        "superseded"
      ],
      "default": "proposed"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "supersedes": {
      "type": "string",
      "title": "Supersedes (decision id or canonical_id)"
    },
    "superseded_by": {
      "type": "string",
      "title": "Superseded by (decision id or canonical_id)"
    },
    "related_nodes": {
      "type": "array",
      "title": "Related nodes",
      "items": {
        "type": "string"
      }
    },
    "related_workloads": {
      "type": "array",
      "title": "Related workloads",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "title": "Tags",
      "items": {
        "type": "string"
      }
    },
    "canonical_id": {
      "type": "string",
      "title": "Canonical ID (e.g. decision:0003)"
    },
    "source_kind": {
      "type": "string",
      "title": "Source kind",
      "enum": [
        "canonical",
        "manual",
        "observed",
        "inferred",
        "planned",
        "sample"
      ],
      "default": "manual"
    },
    "source_repository": {
      "type": "string",
      "title": "Source repository"
    },
    "source_version": {
      "type": "string",
      "title": "Source schema version"
    },
    "source_commit": {
      "type": "string",
      "title": "Source commit (value change)"
    },
    "imported_at": {
      "type": "string",
      "format": "date-time",
      "title": "Imported at (value change)"
    },
    "last_seen_source_commit": {
      "type": "string",
      "title": "Last seen in canonical snapshot (commit)"
    },
    "last_seen_import_at": {
      "type": "string",
      "format": "date-time",
      "title": "Last seen in canonical snapshot (import time)"
    }
  },
  "required": [
    "decision_id",
    "title"
  ]
}