{
  "name": "Node",
  "type": "object",
  "properties": {
    "hostname": {
      "type": "string",
      "title": "Display hostname (canonical identity.physical_name or id fallback)"
    },
    "physical_name": {
      "type": "string",
      "title": "Canonical physical name (identity.physical_name from V1)"
    },
    "fqdn": {
      "type": "string",
      "title": "Fully qualified domain name (identity.fqdn from V1)"
    },
    "purpose": {
      "type": "array",
      "title": "Purpose declarations (V1)",
      "items": {
        "type": "string"
      }
    },
    "memory_gib": {
      "type": "number",
      "title": "Canonical memory capacity (GiB \u2014 V1 resources.memory_gib)"
    },
    "description": {
      "type": "string",
      "title": "Friendly description"
    },
    "node_type": {
      "type": "string",
      "title": "Node type",
      "enum": [
        "workstation",
        "server",
        "hypervisor",
        "utility",
        "appliance",
        "other"
      ],
      "default": "server"
    },
    "manufacturer": {
      "type": "string",
      "title": "Manufacturer"
    },
    "model": {
      "type": "string",
      "title": "Model"
    },
    "motherboard": {
      "type": "string",
      "title": "Motherboard"
    },
    "cpu_model": {
      "type": "string",
      "title": "CPU model (V1 resources.cpu.model)"
    },
    "socket_count": {
      "type": "number",
      "title": "Socket count",
      "default": 1
    },
    "physical_cores": {
      "type": "number",
      "title": "Physical cores"
    },
    "logical_cpus": {
      "type": "number",
      "title": "Logical CPUs"
    },
    "ram_capacity_gb": {
      "type": "number",
      "title": "RAM capacity (GB \u2014 legacy Atlas-local; prefer memory_gib for canonical)"
    },
    "ram_configuration": {
      "type": "string",
      "title": "RAM configuration"
    },
    "gpus": {
      "type": "array",
      "title": "GPU list",
      "items": {
        "type": "string"
      }
    },
    "gpu_vram_gb": {
      "type": "number",
      "title": "Total GPU VRAM (GB)",
      "default": 0
    },
    "nics": {
      "type": "array",
      "title": "NIC list",
      "items": {
        "type": "string"
      }
    },
    "capabilities": {
      "type": "array",
      "title": "Capability declarations (V1)",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "power_supply": {
      "type": "string",
      "title": "Power supply"
    },
    "idle_power_w": {
      "type": "number",
      "title": "Estimated idle power (W)"
    },
    "max_power_w": {
      "type": "number",
      "title": "Estimated maximum power (W)"
    },
    "os_hypervisor": {
      "type": "string",
      "title": "OS / Hypervisor"
    },
    "management_address": {
      "type": "string",
      "title": "Management address"
    },
    "lifecycle_state": {
      "type": "string",
      "title": "Lifecycle state (V1 lifecycle.state)",
      "enum": [
        "planned",
        "onboarding",
        "active",
        "experimental",
        "maintenance",
        "degraded",
        "retiring",
        "retired"
      ],
      "default": "active"
    },
    "availability_expectation": {
      "type": "string",
      "title": "Availability expectation (V1 availability.expected)",
      "enum": [
        "always_on",
        "business_hours",
        "on_demand",
        "best_effort"
      ],
      "default": "best_effort"
    },
    "physical_location": {
      "type": "string",
      "title": "Physical location"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "tags": {
      "type": "array",
      "title": "Tags",
      "items": {
        "type": "string"
      }
    },
    "canonical_id": {
      "type": "string",
      "title": "Canonical ID (e.g. node:rig9)"
    },
    "source_kind": {
      "type": "string",
      "title": "Source kind",
      "enum": [
        "canonical",
        "manual",
        "observed",
        "inferred",
        "planned",
        "sample"
      ],
      "default": "manual"
    },
    "source_repository": {
      "type": "string",
      "title": "Source repository"
    },
    "source_version": {
      "type": "string",
      "title": "Source schema version"
    },
    "source_commit": {
      "type": "string",
      "title": "Source commit (value change)"
    },
    "imported_at": {
      "type": "string",
      "format": "date-time",
      "title": "Imported at (Atlas import time)"
    },
    "source_generated_at": {
      "type": "string",
      "format": "date-time",
      "title": "Source artifact generated_at (producer)"
    },
    "last_seen_source_commit": {
      "type": "string",
      "title": "Last seen in canonical snapshot (commit)"
    },
    "last_seen_import_at": {
      "type": "string",
      "format": "date-time",
      "title": "Last seen in canonical snapshot (Atlas import time)"
    },
    "external_id": {
      "type": "string",
      "title": "External canonical ID (legacy)"
    },
    "import_source": {
      "type": "string",
      "title": "Import source (legacy)"
    },
    "import_timestamp": {
      "type": "string",
      "format": "date-time",
      "title": "Import timestamp (legacy)"
    },
    "source_note": {
      "type": "string",
      "title": "Provenance source note"
    },
    "confidence": {
      "type": "number",
      "title": "Confidence (0-1)"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Observed at"
    },
    "field_provenance": {
      "type": "string",
      "title": "Field-level provenance overlay (JSON)"
    }
  },
  "required": [
    "hostname"
  ]
}