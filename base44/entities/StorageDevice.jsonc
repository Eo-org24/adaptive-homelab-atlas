{
  "name": "StorageDevice",
  "type": "object",
  "properties": {
    "manufacturer": {
      "type": "string",
      "title": "Manufacturer"
    },
    "model": {
      "type": "string",
      "title": "Model"
    },
    "serial_number": {
      "type": "string",
      "title": "Serial number"
    },
    "capacity_gb": {
      "type": "number",
      "title": "Capacity (GB)"
    },
    "media_type": {
      "type": "string",
      "title": "Media type",
      "enum": [
        "hdd",
        "ssd",
        "nvme",
        "sd",
        "other"
      ],
      "default": "ssd"
    },
    "protocol": {
      "type": "string",
      "title": "Protocol",
      "enum": [
        "sata",
        "sas",
        "nvme",
        "usb",
        "other"
      ],
      "default": "sata"
    },
    "firmware": {
      "type": "string",
      "title": "Firmware"
    },
    "current_node": {
      "type": "string",
      "title": "Current node (id)"
    },
    "physical_bay": {
      "type": "string",
      "title": "Physical bay / location"
    },
    "health": {
      "type": "string",
      "title": "Health classification",
      "enum": [
        "healthy",
        "warning",
        "failing",
        "unknown",
        "retired"
      ],
      "default": "healthy"
    },
    "intended_purpose": {
      "type": "string",
      "title": "Intended purpose"
    },
    "state_class": {
      "type": "string",
      "title": "State class (provenance)",
      "enum": [
        "documented",
        "observed",
        "imported",
        "inferred",
        "planned",
        "sample"
      ],
      "default": "documented"
    },
    "purchase_notes": {
      "type": "string",
      "title": "Purchase / source notes"
    },
    "commissioning_date": {
      "type": "string",
      "format": "date",
      "title": "Commissioning date"
    },
    "retirement_date": {
      "type": "string",
      "format": "date",
      "title": "Retirement date"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "canonical_id": {
      "type": "string",
      "title": "Canonical ID (e.g. storage:sg-001)"
    },
    "source_kind": {
      "type": "string",
      "title": "Source kind",
      "enum": [
        "canonical",
        "manual",
        "observed",
        "inferred",
        "planned",
        "sample"
      ],
      "default": "manual"
    },
    "source_repository": {
      "type": "string",
      "title": "Source repository"
    },
    "source_version": {
      "type": "string",
      "title": "Source schema version"
    },
    "source_commit": {
      "type": "string",
      "title": "Source commit"
    },
    "imported_at": {
      "type": "string",
      "format": "date-time",
      "title": "Imported at"
    },
    "external_id": {
      "type": "string",
      "title": "External canonical ID (legacy)"
    },
    "import_source": {
      "type": "string",
      "title": "Import source (legacy)"
    },
    "import_timestamp": {
      "type": "string",
      "format": "date-time",
      "title": "Import timestamp (legacy)"
    },
    "source_note": {
      "type": "string",
      "title": "Provenance source note"
    },
    "confidence": {
      "type": "number",
      "title": "Confidence (0-1)"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Observed at"
    },
    "field_provenance": {
      "type": "string",
      "title": "Field-level provenance overlay (JSON)"
    }
  },
  "required": [
    "model"
  ]
}