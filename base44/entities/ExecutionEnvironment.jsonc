{
  "name": "ExecutionEnvironment",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Display name (canonical id fallback when V1 has no name)"
    },
    "type": {
      "type": "string",
      "title": "Atlas internal type (V1 runtime.kind mapped; 'unknown' when not declared)",
      "enum": [
        "physical_host",
        "vm",
        "lxc",
        "docker",
        "podman",
        "kubernetes",
        "external_service",
        "unknown"
      ],
      "default": "unknown"
    },
    "runtime_kind": {
      "type": "string",
      "title": "Canonical runtime kind (V1 runtime.kind \u2014 preserved verbatim)"
    },
    "autostart": {
      "type": "boolean",
      "title": "Autostart (V1 runtime.autostart)"
    },
    "purpose": {
      "type": "array",
      "title": "Purpose declarations (V1)",
      "items": {
        "type": "string"
      }
    },
    "current_host": {
      "type": "string",
      "title": "Current host node (id) \u2014 structural realization via hosted_on"
    },
    "cpu_allocation": {
      "type": "number",
      "title": "CPU allocation (cores)"
    },
    "ram_allocation_gb": {
      "type": "number",
      "title": "RAM allocation (GB)"
    },
    "storage_allocation_gb": {
      "type": "number",
      "title": "Storage allocation (GB)"
    },
    "lifecycle": {
      "type": "string",
      "title": "Lifecycle",
      "enum": [
        "planned",
        "onboarding",
        "active",
        "experimental",
        "maintenance",
        "degraded",
        "retiring",
        "retired"
      ],
      "default": "active"
    },
    "reconstructable": {
      "type": "boolean",
      "title": "Reconstructable",
      "default": true
    },
    "persistent_state": {
      "type": "boolean",
      "title": "Persistent state",
      "default": false
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "tags": {
      "type": "array",
      "title": "Tags",
      "items": {
        "type": "string"
      }
    },
    "capabilities": {
      "type": "array",
      "title": "Capability declarations (V1)",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "canonical_id": {
      "type": "string",
      "title": "Canonical ID (e.g. execution-provider:tools1)"
    },
    "source_kind": {
      "type": "string",
      "title": "Source kind",
      "enum": [
        "canonical",
        "manual",
        "observed",
        "inferred",
        "planned",
        "sample"
      ],
      "default": "manual"
    },
    "source_repository": {
      "type": "string",
      "title": "Source repository"
    },
    "source_version": {
      "type": "string",
      "title": "Source schema version"
    },
    "source_commit": {
      "type": "string",
      "title": "Source commit (value change)"
    },
    "imported_at": {
      "type": "string",
      "format": "date-time",
      "title": "Imported at (Atlas import time)"
    },
    "source_generated_at": {
      "type": "string",
      "format": "date-time",
      "title": "Source artifact generated_at (producer)"
    },
    "last_seen_source_commit": {
      "type": "string",
      "title": "Last seen in canonical snapshot (commit)"
    },
    "last_seen_import_at": {
      "type": "string",
      "format": "date-time",
      "title": "Last seen in canonical snapshot (Atlas import time)"
    },
    "field_provenance": {
      "type": "string",
      "title": "Field-level provenance overlay (JSON)"
    }
  },
  "required": [
    "name",
    "type"
  ]
}