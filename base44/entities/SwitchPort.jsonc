{
  "name": "SwitchPort",
  "type": "object",
  "properties": {
    "device": {
      "type": "string",
      "title": "Device (id)"
    },
    "port_identifier": {
      "type": "string",
      "title": "Port identifier"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "speed": {
      "type": "string",
      "title": "Speed",
      "enum": [
        "10M",
        "100M",
        "1G",
        "2.5G",
        "10G",
        "25G",
        "40G",
        "100G",
        "unknown"
      ],
      "default": "1G"
    },
    "media": {
      "type": "string",
      "title": "Media",
      "enum": [
        "copper",
        "fiber",
        "sfp",
        "sfp28",
        "qsfp",
        "unknown"
      ],
      "default": "copper"
    },
    "connected_device": {
      "type": "string",
      "title": "Connected device"
    },
    "connected_interface": {
      "type": "string",
      "title": "Connected interface"
    },
    "vlan_network": {
      "type": "string",
      "title": "VLAN / Network"
    },
    "admin_state": {
      "type": "string",
      "title": "Administrative state",
      "enum": [
        "enabled",
        "disabled",
        "planned"
      ],
      "default": "enabled"
    },
    "observed_link_state": {
      "type": "string",
      "title": "Observed link state",
      "enum": [
        "up",
        "down",
        "unknown",
        "planned"
      ],
      "default": "unknown"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "canonical_id": {
      "type": "string",
      "title": "Canonical ID (e.g. switch-port:t2600-1)"
    },
    "source_kind": {
      "type": "string",
      "title": "Source kind",
      "enum": [
        "canonical",
        "manual",
        "observed",
        "inferred",
        "planned",
        "sample"
      ],
      "default": "manual"
    },
    "source_repository": {
      "type": "string",
      "title": "Source repository"
    },
    "source_version": {
      "type": "string",
      "title": "Source schema version"
    },
    "source_commit": {
      "type": "string",
      "title": "Source commit (value change)"
    },
    "imported_at": {
      "type": "string",
      "format": "date-time",
      "title": "Imported at (value change)"
    },
    "last_seen_source_commit": {
      "type": "string",
      "title": "Last seen in canonical snapshot (commit)"
    },
    "last_seen_import_at": {
      "type": "string",
      "format": "date-time",
      "title": "Last seen in canonical snapshot (import time)"
    }
  },
  "required": [
    "device",
    "port_identifier"
  ]
}