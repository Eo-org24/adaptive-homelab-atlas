{
  "name": "Dependency",
  "type": "object",
  "properties": {
    "source_type": {
      "type": "string",
      "title": "Source type",
      "enum": [
        "workload",
        "environment",
        "node"
      ],
      "default": "workload"
    },
    "source_id": {
      "type": "string",
      "title": "Source id"
    },
    "target_type": {
      "type": "string",
      "title": "Target type",
      "enum": [
        "workload",
        "environment",
        "node",
        "network_service",
        "storage",
        "external"
      ],
      "default": "workload"
    },
    "target_id": {
      "type": "string",
      "title": "Target id"
    },
    "target_name": {
      "type": "string",
      "title": "Target name (external only)"
    },
    "kind": {
      "type": "string",
      "title": "Kind",
      "enum": [
        "hard",
        "soft",
        "optional"
      ],
      "default": "hard"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "canonical_id": {
      "type": "string",
      "title": "Canonical ID"
    },
    "source_kind": {
      "type": "string",
      "title": "Source kind",
      "enum": [
        "canonical",
        "manual",
        "observed",
        "inferred",
        "planned",
        "sample"
      ],
      "default": "manual"
    },
    "source_repository": {
      "type": "string",
      "title": "Source repository"
    },
    "source_version": {
      "type": "string",
      "title": "Source schema version"
    },
    "source_commit": {
      "type": "string",
      "title": "Source commit (value change)"
    },
    "imported_at": {
      "type": "string",
      "format": "date-time",
      "title": "Imported at (value change)"
    },
    "last_seen_source_commit": {
      "type": "string",
      "title": "Last seen in canonical snapshot (commit)"
    },
    "last_seen_import_at": {
      "type": "string",
      "format": "date-time",
      "title": "Last seen in canonical snapshot (import time)"
    }
  },
  "required": [
    "source_type",
    "source_id",
    "target_type",
    "target_id"
  ]
}